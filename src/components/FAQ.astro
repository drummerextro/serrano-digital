---
import { faqs } from '../config';
---

<section id="faq">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Questions</span>
      <h2>FAQ</h2>
    </div>

    <div class="faq-list">
      {faqs.map((item) => (
        <details class="faq-item">
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
