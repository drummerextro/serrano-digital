---
import { businessServices } from '../config';
---

<section id="business">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">For local businesses</span>
      <h2>Small Business IT</h2>
      <p>
        Serrano Digital also helps small local businesses keep their technology
        running — without the cost or commitment of a managed-services contract.
      </p>
    </div>

    <ul class="business-list">
      {businessServices.map((item) => (
        <li>{item}</li>
      ))}
    </ul>

    <a class="btn btn-primary" href="#contact">Ask About Business Support</a>
  </div>
</section>
