---
import { pricing } from '../config';
---

<section id="pricing">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">No surprises</span>
      <h2>Pricing</h2>
      <p>Flat, upfront rates. No packages to decode, no hidden fees.</p>
    </div>

    <div class="pricing-grid">
      <div class="price-card price-card--accent">
        <h3>In-Home Support</h3>
        <p class="price-card__amount">${pricing.inHomeFirstHour}<span> first hour</span></p>
        <p>Additional time billed in {pricing.inHomeIncrementMinutes}-minute increments.</p>
      </div>

      <div class="price-card">
        <h3>Remote Support</h3>
        <p class="price-card__amount">${pricing.remoteHourly}<span>/hour</span></p>
        <p>For software and configuration issues that don't need a hands-on visit.</p>
      </div>

      <div class="price-card">
        <h3>Small Business IT</h3>
        <p class="price-card__amount">From ${pricing.businessHourlyFrom}<span>/hour</span></p>
        <p>Workstations, networks, printers and ongoing support — no contract required.</p>
      </div>
    </div>

    <div class="pricing-note">
      <p>Not sure what you need? Tell me what's happening before booking.</p>
      <a class="btn btn-primary" href="#contact">Describe My Problem</a>
    </div>
  </div>
</section>
