---
import { business } from '../config';
---

<section id="about">
  <div class="container about__grid">
    <div class="about__badge">
      <strong>A+</strong>
      {business.credential}
    </div>

    <div class="about__content">
      <span class="eyebrow">About</span>
      <h2>Hi, I'm {business.ownerFirstName}.</h2>
      <p>
        I'm a {business.credential} technician with experience in computer
        repair, IT support, networking, web technology and technical
        instruction.
      </p>
      <p>
        Serrano Digital originally covered a broad range of digital services.
        Today I'm putting the focus where it is most useful: helping people
        and small businesses in my neighborhood get their technology working.
      </p>
      <p>
        I work with Windows PCs, Macs, home networks and everyday technology
        problems, and I also provide website and IT support for local
        businesses.
      </p>
    </div>
  </div>
</section>
